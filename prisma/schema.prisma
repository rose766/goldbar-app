generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "linux-musl-openssl-3.0.x" covers node:22-alpine (Docker).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── CLIENT ───────────────────────────────────────────────────────────────────

model Client {
  id                    String        @id @default(cuid())
  name                  String
  status                String        @default("ACTIVE")
  accountManager        String        @default("Rose")
  health                String        @default("ON_TRACK")
  healthReasons         String?       // JSON array of strings explaining the health score
  nextCheckIn           DateTime?
  lastActivity          DateTime?
  lastDashboardUpdate   DateTime?
  lastDocumentSync      DateTime?     // last time a document was processed for this client
  lastItemUpdate        DateTime?
  lastConfirmedActivity DateTime?
  staleThresholdDays    Int           @default(5)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  vas                   VA[]
  openItems             OpenItem[]
  gamePlans             GamePlan[]
  healthHistory         ClientHealthHistory[]
  sourceDocuments       SourceDocument[]
  rhCases               RHCase[]

  @@index([health])
  @@index([status])
}

// ─── VA / EXECUTIVE ASSISTANT ─────────────────────────────────────────────────

model VA {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  role               String?
  startDate          DateTime?
  status             String    @default("ACTIVE")
  currentPriorities  String?
  performanceFlags   String?   // JSON array
  lastClientFeedback String?
  lastUpdate         DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  openItems          OpenItem[]
  milestones         Milestone[]
  rhCases            RHCase[]

  @@index([clientId])
  @@index([status])
}

// ─── SOURCE DOCUMENT ──────────────────────────────────────────────────────────
// Primary input object. Created by Lindy intake or manual upload.
// AI analysis produces ReviewItems; approved ReviewItems become OpenItems.

model SourceDocument {
  id                String    @id @default(cuid())
  clientId          String?   // nullable until client is identified
  client            Client?   @relation(fields: [clientId], references: [id])

  // Identification
  title             String
  fileName          String
  fileType          String    // pptx | pdf | docx | txt | md | google-doc
  sourceType        String    @default("LINDY")  // GOOGLE_DRIVE | LINDY | MANUAL

  // Google Drive
  googleDriveFileId String?   // for deduplication
  googleDriveUrl    String?

  // Versioning
  documentVersion   String?   // e.g. "v2", "Q4 v2"
  contentHash       String?   // SHA-256 of extractedText for dedup

  // Previous version chain
  previousVersionId String?
  previousVersion   SourceDocument?  @relation("DocVersions", fields: [previousVersionId], references: [id])
  laterVersions     SourceDocument[] @relation("DocVersions")

  // Content
  extractedText     String?   // full text extracted from document
  summary           String?   // AI-generated summary

  // Timing
  uploadedAt        DateTime? // when file was uploaded to Drive
  receivedAt        DateTime  @default(now())
  lastProcessedAt   DateTime?

  // Processing state: RECEIVED | EXTRACTING | ANALYZING | READY_FOR_REVIEW | PROCESSED | FAILED
  processingStatus  String    @default("RECEIVED")
  processingError   String?

  // Stats
  proposalsCreated  Int       @default(0)
  proposalsApproved Int       @default(0)
  proposalsRejected Int       @default(0)
  itemsCreated      Int       @default(0)

  // Raw intake payload (JSON blob from Lindy)
  rawMetadata       String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviewItems       ReviewItem[]
  gamePlans         GamePlan[]
  openItems         OpenItem[]

  @@index([clientId])
  @@index([googleDriveFileId])
  @@index([processingStatus])
  @@index([sourceType])
  @@index([contentHash])
}

// ─── GAME PLAN ────────────────────────────────────────────────────────────────

model GamePlan {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceDocumentId   String?   // FK to SourceDocument that generated this game plan
  sourceDocument     SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  title              String
  version            Int       @default(1)
  status             String    @default("ACTIVE")
  date               DateTime
  summary            String?
  keyObjectives      String?
  keyCommitments     String?
  nextSteps          String?
  sourceExcerpt      String?   // relevant text excerpt from source document
  sourceLink         String?   // Google Drive URL or other source link
  lastReviewed       DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  previousVersionId  String?
  previousVersion    GamePlan? @relation("GamePlanVersions", fields: [previousVersionId], references: [id])
  laterVersions      GamePlan[] @relation("GamePlanVersions")

  objectives         Objective[]
  openItems          OpenItem[]

  @@index([clientId])
  @@index([status])
  @@index([sourceDocumentId])
}

// ─── OBJECTIVE ────────────────────────────────────────────────────────────────

model Objective {
  id          String    @id @default(cuid())
  gamePlanId  String
  gamePlan    GamePlan  @relation(fields: [gamePlanId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("IN_PROGRESS")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  notes       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  milestones  Milestone[]
  openItems   OpenItem[]

  @@index([gamePlanId])
}

// ─── MILESTONE ────────────────────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  vaId        String?
  va          VA?       @relation(fields: [vaId], references: [id])
  title       String
  description String?
  status      String    @default("NOT_STARTED")
  deadline    DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  openItems   OpenItem[]

  @@index([objectiveId])
}

// ─── OPEN ITEM ────────────────────────────────────────────────────────────────

model OpenItem {
  id               String     @id @default(cuid())
  clientId         String
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vaId             String?
  va               VA?        @relation(fields: [vaId], references: [id])
  gamePlanId       String?
  gamePlan         GamePlan?  @relation(fields: [gamePlanId], references: [id])
  objectiveId      String?
  objective        Objective? @relation(fields: [objectiveId], references: [id])
  milestoneId      String?
  milestone        Milestone? @relation(fields: [milestoneId], references: [id])
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  // Core
  title        String
  description  String?
  nextStep     String?

  // Ownership
  owner             String?
  ownerType         String  @default("UNASSIGNED")
  ownerConfidence   String  @default("HIGH")

  // AM Follow-Up (SEPARATE from task owner — the AM responsible for following up)
  amFollowUp      Boolean   @default(false)
  amFollowUpDate  DateTime?
  amFollowUpNotes String?

  // Deadline
  deadline           DateTime?
  deadlineStatus     String    @default("CONFIRMED")
  deadlineConfidence String    @default("HIGH")

  // Status & Priority
  status    String @default("NOT_STARTED")
  priority  String @default("MEDIUM")

  // Computed flags (stored for query performance)
  isOverdue         Boolean @default(false)
  isDueSoon         Boolean @default(false)
  isStale           Boolean @default(false)
  isMissingDeadline Boolean @default(false)
  isMissingOwner    Boolean @default(false)
  isMissingNextStep Boolean @default(false)
  isClientLevel     Boolean @default(false)

  // Waiting tracking
  waitingSince DateTime?
  waitingFor   String?

  // Stale / Last Confirmed
  lastConfirmed       DateTime?
  lastConfirmedSource String?

  // Blocker
  blockerDescription String?
  dependency         String?

  // Source traceability
  source          String   @default("MANUAL")
  sourceDate      DateTime?
  sourceMessage   String?  // excerpt from source document
  sourceLink      String?  // Google Drive URL

  // Completion
  completionEvidence String?
  completedDate      DateTime?

  // Confidence
  confidenceLevel String @default("HIGH")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history     OpenItemHistory[]
  reviewItems ReviewItem[]

  @@index([clientId])
  @@index([vaId])
  @@index([status])
  @@index([priority])
  @@index([isOverdue])
  @@index([amFollowUp])
  @@index([isMissingDeadline])
  @@index([isMissingOwner])
  @@index([deadline])
  @@index([sourceDocumentId])
}

// ─── OPEN ITEM HISTORY (AUDIT TRAIL) ─────────────────────────────────────────

model OpenItemHistory {
  id           String   @id @default(cuid())
  openItemId   String
  openItem     OpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  changedAt    DateTime @default(now())
  field        String
  previousValue String?
  newValue      String?
  reason        String?
  source        String?
  sourceLink    String?
  changedBy     String?
  reviewItemId  String?

  @@index([openItemId])
  @@index([changedAt])
}

// ─── CLIENT HEALTH HISTORY ────────────────────────────────────────────────────

model ClientHealthHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  changedAt DateTime @default(now())
  fromHealth String
  toHealth   String
  reasons    String
  source     String?

  @@index([clientId])
}

// ─── AI REVIEW QUEUE ──────────────────────────────────────────────────────────

model ReviewItem {
  id               String          @id @default(cuid())
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  openItemId       String?
  openItem         OpenItem?       @relation(fields: [openItemId], references: [id])

  reviewType       String
  status           String          @default("PENDING")

  aiInterpretation String
  aiConfidence     String
  proposedAction   String
  proposedData     String          // JSON blob

  // Source traceability
  sourceMessage    String?         // relevant excerpt from document
  sourceTimestamp  String?
  sourceLink       String?         // Google Drive URL

  // Confidence and review metadata
  isDryRun        Boolean  @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  finalValue      String?
  rejectionReason String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewType])
  @@index([openItemId])
  @@index([isDryRun])
  @@index([sourceDocumentId])
}

// ─── DAILY SUMMARY ────────────────────────────────────────────────────────────

model DailySummary {
  id               String   @id @default(cuid())
  date             DateTime @unique
  newItems         Int      @default(0)
  completedItems   Int      @default(0)
  updatedItems     Int      @default(0)
  overdueItems     Int      @default(0)
  dueSoonItems     Int      @default(0)
  missingDeadlines Int      @default(0)
  missingOwners    Int      @default(0)
  atRiskClients    Int      @default(0)
  pendingReviews   Int      @default(0)
  fullSummaryJson  String?
  generatedAt      DateTime @default(now())

  @@index([date])
}

// ═══════════════════════════════════════════════════════════════════════════════
// RELATIONSHIP HEALTH MODULE
// ═══════════════════════════════════════════════════════════════════════════════

// ─── RH: CASE NUMBER COUNTER ──────────────────────────────────────────────────
model RHCaseCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

// ─── RH: ACTION NUMBER COUNTER ────────────────────────────────────────────────
model RHActionCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

// ─── RH: RELATIONSHIP CASE ────────────────────────────────────────────────────
model RHCase {
  id           String   @id @default(cuid())
  caseNumber   String   @unique // GB-RH-00001

  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  vaId         String?
  va           VA?      @relation(fields: [vaId], references: [id])

  assignedAm      String
  assignedTrainer String?
  createdBy       String

  title           String
  description     String
  status          String @default("NEW")
  severity        String @default("MODERATE")
  dateIdentified  DateTime
  sourceOfConcern String?
  clientFeedback  String?
  vaFeedback      String?
  healthStatus    String @default("INSUFFICIENT_INFORMATION")
  nextReviewDate  DateTime?
  closedAt        DateTime?
  resolvedAt      DateTime?
  statusReason    String?
  tags            String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios     RHCaseScenario[]
  assessments   RHAssessment[]
  evidence      RHEvidence[]
  rootCauses    RHRootCause[]
  coachingPlans RHCoachingPlan[]
  customScripts RHCustomScript[]
  actions       RHAction[]
  followUps     RHFollowUp[]
  escalation    RHEscalation?
  aiRecs        RHAiRec[]
  statusHistory RHStatusHistory[]
  auditLogs     RHAuditLog[]

  @@index([clientId])
  @@index([vaId])
  @@index([status])
  @@index([severity])
  @@index([assignedAm])
  @@index([healthStatus])
}

// ─── RH: SCENARIO DEFINITION ──────────────────────────────────────────────────
model RHScenario {
  id                  String @id @default(cuid())
  scenarioNumber      Int    @unique
  title               String
  category            String
  description         String
  warningSigns        String // JSON array
  potentialRootCauses String // JSON array
  vaQuestions         String // JSON array
  clientQuestions     String // JSON array
  evidenceToCollect   String // JSON array
  vaCoaching          String // JSON array
  vaScript            String // default VA communication script
  clientScript        String // default client communication script
  correctiveActions   String // JSON array
  successMeasures     String // JSON array
  escalationCriteria  String // JSON array
  relatedScenarios    String @default("[]") // JSON array of scenarioNumbers
  defaultSeverity     String @default("MODERATE")
  isCustom            Boolean @default(false)
  isActive            Boolean @default(true)
  version             Int     @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  caseLinks       RHCaseScenario[]
  scriptTemplates RHScriptTemplate[]

  @@index([scenarioNumber])
  @@index([category])
  @@index([isActive])
}

// ─── RH: CASE-SCENARIO JUNCTION ───────────────────────────────────────────────
model RHCaseScenario {
  id           String     @id @default(cuid())
  caseId       String
  case         RHCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scenarioId   String
  scenario     RHScenario @relation(fields: [scenarioId], references: [id])
  isPrimary    Boolean    @default(false)
  addedAt      DateTime   @default(now())
  addedBy      String?
  snapshotJson String?    // JSON snapshot of scenario at time of association

  @@unique([caseId, scenarioId])
  @@index([caseId])
  @@index([scenarioId])
}

// ─── RH: ASSESSMENT ───────────────────────────────────────────────────────────
model RHAssessment {
  id             String   @id @default(cuid())
  caseId         String
  case           RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assessedBy     String
  status         String   @default("DRAFT") // DRAFT | COMPLETED | SUPERSEDED
  assessmentDate DateTime @default(now())
  completedAt    DateTime?
  version        Int      @default(1)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  responses RHAssessmentResponse[]

  @@index([caseId])
  @@index([status])
}

// ─── RH: ASSESSMENT RESPONSE ──────────────────────────────────────────────────
model RHAssessmentResponse {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   RHAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section      String       // A | B | C | D | E | F | G | H
  questionKey  String
  questionText String
  answer       String       // YES | NO | UNKNOWN | NA
  evidenceNote String?
  notes        String?
  sourceType   String?      // OBSERVED | VA_STATEMENT | CLIENT_STATEMENT | AM_INTERPRETATION
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assessmentId])
  @@index([section])
}

// ─── RH: EVIDENCE ─────────────────────────────────────────────────────────────
model RHEvidence {
  id          String   @id @default(cuid())
  caseId      String
  case        RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  description String
  sourceType  String   // OBSERVED | VA_STATEMENT | CLIENT_STATEMENT | AM_INTERPRETATION | DOCUMENT | OTHER
  recordedBy  String
  recordedAt  DateTime @default(now())
  isConfirmed Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId])
  @@index([sourceType])
}

// ─── RH: ROOT CAUSE ───────────────────────────────────────────────────────────
model RHRootCause {
  id                 String   @id @default(cuid())
  caseId             String
  case               RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category           String   // VA_CAPABILITY | VA_INITIATIVE | CLIENT_ENGAGEMENT | CLIENT_DELEGATION | COMMUNICATION | MISSING_ACCESS | MISSING_CONTEXT | WORKLOAD | ROLE_MISMATCH | RELATIONSHIP | PROCESS | SCOPE | CONDUCT | UNKNOWN
  description        String
  supportingEvidence String?
  isPrimary          Boolean  @default(false)
  confidence         String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  isAiGenerated      Boolean  @default(false)
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([caseId])
  @@index([isPrimary])
}

// ─── RH: COACHING PLAN ────────────────────────────────────────────────────────
model RHCoachingPlan {
  id                   String   @id @default(cuid())
  caseId               String
  case                 RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version              Int      @default(1)
  status               String   @default("DRAFT") // DRAFT | APPROVED | SUPERSEDED | ARCHIVED
  title                String
  objective            String
  rootCauseExplanation String?
  vaActions            String   @default("[]") // JSON array
  clientActions        String   @default("[]") // JSON array
  amActions            String   @default("[]") // JSON array
  successMeasures      String?
  reviewSchedule       String?
  contingency          String?
  startDate            DateTime?
  targetEndDate        DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  isAiGenerated        Boolean  @default(false)
  aiModelId            String?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([caseId])
  @@index([status])
}

// ─── RH: SCRIPT TEMPLATE ──────────────────────────────────────────────────────
model RHScriptTemplate {
  id         String      @id @default(cuid())
  scenarioId String?
  scenario   RHScenario? @relation(fields: [scenarioId], references: [id])
  category   String
  title      String
  recipient  String      // VA | CLIENT | AM
  channel    String?     // EMAIL | SLACK | CALL | ANY
  tone       String      @default("DIRECT") // WARM | DIRECT | GENTLE | CONCISE
  content    String
  isDefault  Boolean     @default(true)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([scenarioId])
  @@index([category])
  @@index([recipient])
}

// ─── RH: CUSTOM SCRIPT ────────────────────────────────────────────────────────
model RHCustomScript {
  id         String   @id @default(cuid())
  caseId     String
  case       RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId String?
  title      String
  recipient  String
  channel    String?
  tone       String   @default("DIRECT")
  content    String
  usedAt     DateTime?
  usedBy     String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([caseId])
}

// ─── RH: RECOVERY ACTION ──────────────────────────────────────────────────────
model RHAction {
  id                   String   @id @default(cuid())
  caseId               String
  case                 RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actionNumber         String   @unique
  title                String
  description          String?
  assignedRole         String   // VA | CLIENT | AM | TRAINER | LEADERSHIP
  assignedTo           String?
  dueDate              DateTime?
  priority             String   @default("MEDIUM")
  status               String   @default("NOT_STARTED")
  relatedScenarioId    String?
  expectedResult       String?
  completionEvidence   String?
  completedAt          DateTime?
  blockerReason        String?
  blockerOwner         String?
  blockerFollowUpDate  DateTime?
  cancelReason         String?
  createdBy            String
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
  @@index([assignedTo])
}

// ─── RH: FOLLOW-UP ────────────────────────────────────────────────────────────
model RHFollowUp {
  id          String   @id @default(cuid())
  caseId      String
  case        RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  purpose     String
  assignedTo  String
  dueDate     DateTime
  dueTime     String?
  status      String   @default("PENDING") // PENDING | COMPLETED | SKIPPED
  notes       String?
  outcome     String?
  nextStep    String?
  completedAt DateTime?
  checkType   String?  // VA_CHECKIN | CLIENT_CHECKIN | PLAN_REVIEW | EVIDENCE | ESCALATION | REASSESSMENT | OTHER
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([dueDate])
  @@index([assignedTo])
}

// ─── RH: CASE STATUS HISTORY ──────────────────────────────────────────────────
model RHStatusHistory {
  id         String   @id @default(cuid())
  caseId     String
  case       RHCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  reason     String?
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([caseId])
  @@index([changedAt])
}

// ─── RH: ESCALATION ───────────────────────────────────────────────────────────
model RHEscalation {
  id                String @id @default(cuid())
  caseId            String @unique
  case              RHCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reason            String
  specificEvidence  String?
  previousCoaching  String?
  clientPerspective String?
  vaPerspective     String?
  amRecommendation  String?
  risks             String?
  escalatedBy       String
  escalatedAt       DateTime @default(now())
  status            String   @default("PENDING") // PENDING | REVIEWED | DECIDED | CLOSED
  decision          String?
  decisionNotes     String?
  decidedBy         String?
  decidedAt         DateTime?
  nextSteps         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

// ─── RH: AI RECOMMENDATION ────────────────────────────────────────────────────
model RHAiRec {
  id                 String @id @default(cuid())
  caseId             String
  case               RHCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  modelId            String
  generatedAt        DateTime @default(now())
  inputVersion       String?
  status             String   @default("DRAFT") // DRAFT | APPROVED | REJECTED | SUPERSEDED
  summaryText        String
  primaryRootCause   String?
  contributingFactors String?
  supportingEvidence  String?
  missingInfo        String?
  alternativeExpl    String?
  vaQuestions        String?
  clientQuestions    String?
  vaCoachingRec      String?
  clientChangesRec   String?
  immediateActions   String?
  followUpMeasures   String?
  escalationConcerns String?
  confidenceNote     String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([caseId])
  @@index([status])
}

// ─── RH: AUDIT LOG ────────────────────────────────────────────────────────────
model RHAuditLog {
  id         String   @id @default(cuid())
  caseId     String?
  case       RHCase?  @relation(fields: [caseId], references: [id])
  entityType String   // CASE | ASSESSMENT | ACTION | FOLLOWUP | ESCALATION | COACHING_PLAN | SCENARIO
  entityId   String
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | APPROVE | REJECT
  field      String?
  oldValue   String?
  newValue   String?
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([caseId])
  @@index([entityType])
  @@index([changedAt])
}
